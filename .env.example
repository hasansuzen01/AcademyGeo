# ---------------------------------------------------------------------------
# Shared values for docker compose. Copy to .env before `docker compose up`.
# Per-app secrets live in apps/api/.env and apps/web/.env.local.
# ---------------------------------------------------------------------------

POSTGRES_USER=academygeo
POSTGRES_PASSWORD=
POSTGRES_DB=academygeo
POSTGRES_PORT=5433

REDIS_PORT=6380

API_PORT=3001
WEB_PORT=3000

# Passed through to the api container.
# Hostname of the R2 bucket, baked into the web image at build time.
NEXT_PUBLIC_MEDIA_HOST=

BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
