# ---------------------------------------------------------------------------
# Shared values for docker compose. Copy to .env before `docker compose up`.
# Per-app secrets live in apps/api/.env and apps/web/.env.local.
# ---------------------------------------------------------------------------

POSTGRES_USER=academygeo
POSTGRES_PASSWORD=
POSTGRES_DB=academygeo
POSTGRES_PORT=5433

REDIS_PORT=6380

API_PORT=3001
WEB_PORT=3000

# The R2 bucket address, baked into the web image at build time. Paste what
# Cloudflare shows, e.g. https://pub-abc123.r2.dev, or just the hostname.
NEXT_PUBLIC_MEDIA_HOST=

# ---------------------------------------------------------------------------
# Passed through to the api container. Compose does not read apps/api/.env, so
# every value the API needs has to be repeated here to run the whole stack in
# Docker. Copy them from apps/api/.env.
# ---------------------------------------------------------------------------

BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only needed when web and api sit on different subdomains, e.g. .academygeo.com
AUTH_COOKIE_DOMAIN=

# Comma-separated. Signing in with one of these addresses creates an admin.
ADMIN_EMAILS=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
