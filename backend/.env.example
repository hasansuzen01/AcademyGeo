# ---------------------------------------------------------------------------
# AcademyGeo API
# Copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# HTTP
PORT=3001
NODE_ENV=development

# Public URL of this API, used by Better Auth to build callback URLs.
API_URL=http://localhost:3001

# Public URL of the Next.js app. Comma-separate extra origins if you deploy
# preview environments.
WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (matches docker-compose.yml when run locally)
DATABASE_URL=postgresql://academygeo:academygeo@localhost:5433/academygeo?schema=public

# Redis (session + stats cache, review queue)
REDIS_URL=redis://localhost:6380

# ---------------------------------------------------------------------------
# Better Auth
# ---------------------------------------------------------------------------
# 32+ char random string. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Google OAuth credentials from https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {API_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cookie domain shared by web and api in production, e.g. .academygeo.com.
# Leave empty for localhost.
AUTH_COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# Admin access
# ---------------------------------------------------------------------------
# Comma-separated emails that become admins the first time they sign in.
# Existing accounts are promoted with:
#   npm run admin:grant --workspace api -- someone@example.com
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Cloudflare R2 (image storage)
# Leave blank to run without uploads; the admin panel then says so instead of
# failing. See docs/servisler.md for how to create each value.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public read URL of the bucket, e.g. https://media.academygeo.com
R2_PUBLIC_BASE_URL=
