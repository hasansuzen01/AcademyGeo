generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth tables. Field names are fixed by the Better Auth Prisma adapter.
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  ADMIN
}

/// A suspended account cannot sign in and does not appear on a leaderboard.
/// Suspension is reversible; deleting the account is not.
enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id            String     @id @default(cuid())
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  suspendedAt   DateTime?
  /// Shown to the admin who lifts the suspension, so the reason survives the
  /// person who wrote it down.
  suspendReason String?
  /// Experience earned from practice. Drives the level shown on the profile.
  xp            Int        @default(0)
  /// Written at most once every few minutes, so "last seen" is answerable
  /// without a database write on every request.
  lastSeenAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts      Account[]
  sessions      Session[]
  reviewCards   ReviewCard[]
  reviewLogs    ReviewLog[]
  dailyActivity DailyActivity[]
  gameRuns      GameRun[]
  achievements  UserAchievement[]
  authoredMetas Meta[]            @relation("MetaAuthor")
  posts         Post[]            @relation("PostAuthor")
  auditLogs     AuditLog[]

  @@index([status])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  // Who vouched for the account, e.g. https://accounts.google.com. Two
  // providers can hand out the same account id, so identity is the pair.
  issuer                String
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Learning content
// ---------------------------------------------------------------------------

enum Region {
  EUROPE
  ASIA
  AFRICA
  NORTH_AMERICA
  SOUTH_AMERICA
  OCEANIA
}

/// Whether the card shows a real photograph or a seeded diagram standing in
/// for one. Photographs fill the card frame; diagrams are letterboxed.
enum ImageSource {
  PHOTO
  ILLUSTRATION
}

enum MetaCategory {
  PLATE
  BOLLARD
  ROAD_LINE
  VEGETATION
  ARCHITECTURE
  LANGUAGE
  CAMERA
  VEHICLE
  INFRASTRUCTURE
}

/// Which side of the road a country drives on. One of the first things a
/// player reads off a street view, so it earns a field of its own rather
/// than a line buried in a description.
enum DrivingSide {
  LEFT
  RIGHT
}

model Country {
  code   String @id
  nameEn String
  nameTr String
  region Region

  // ---------------------------------------------------------------------
  // Atlas facts. Every one is optional: a country is worth practising long
  // before an admin has finished writing it up.
  // ---------------------------------------------------------------------
  flagEmoji   String?
  drivingSide DrivingSide?
  /// Country-code top level domain, e.g. ".tr". Turns up on shop signs.
  ccTld       String?
  /// International dialling prefix, e.g. "+90". Turns up on shop signs too.
  phonePrefix String?
  currency    String?
  /// Comma-separated, e.g. "Turkish,Kurdish".
  languages   String       @default("")
  /// Comma-separated coverage generations, e.g. "Gen 3,Gen 4".
  cameraGens  String       @default("")
  summaryEn   String       @default("")
  summaryTr   String       @default("")

  metas Meta[]
}

model Meta {
  id            String       @id @default(cuid())
  /// Stable human key. Also the filename of a generated illustration.
  slug          String       @unique
  countryCode   String
  category      MetaCategory
  titleEn       String
  titleTr       String
  descriptionEn String
  descriptionTr String
  /// Empty until someone uploads a photograph. A card in that state stays a
  /// draft: the picture is the question, so there is nothing to ask without it.
  imageUrl      String       @default("")
  /// R2 object key when the picture was uploaded rather than generated.
  imageKey      String?
  imageSource   ImageSource  @default(ILLUSTRATION)
  /// Unpublished metas stay out of practice sessions.
  isPublished   Boolean      @default(true)
  /// 1 = obvious at a glance, 5 = only recognisable to experienced players.
  difficulty    Int          @default(2)
  createdById   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  country   Country      @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  createdBy User?        @relation("MetaAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  cards     ReviewCard[]
  logs      ReviewLog[]
  decks     DeckMeta[]

  @@index([countryCode])
  @@index([category])
  @@index([isPublished])
  @@index([imageSource])
}

/// A named set of metas: a themed collection or a time-boxed event.
model Deck {
  id            String    @id @default(cuid())
  slug          String    @unique
  nameEn        String
  nameTr        String
  descriptionEn String    @default("")
  descriptionTr String    @default("")
  coverImageUrl String?
  coverImageKey String?
  isPublished   Boolean   @default(false)
  /// Set both to run the deck as an event with a window.
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  metas DeckMeta[]
  runs  GameRun[]

  @@index([isPublished])
}

model DeckMeta {
  deckId   String
  metaId   String
  position Int    @default(0)

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  meta Meta @relation(fields: [metaId], references: [id], onDelete: Cascade)

  @@id([deckId, metaId])
  @@index([deckId, position])
}

/// Every write an admin makes, so changes to the deck can be traced.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  summary   String
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
// Spaced repetition
// ---------------------------------------------------------------------------

model ReviewCard {
  id             String    @id @default(cuid())
  userId         String
  metaId         String
  repetitions    Int       @default(0)
  intervalDays   Int       @default(0)
  easeFactor     Float     @default(2.5)
  lapses         Int       @default(0)
  dueAt          DateTime  @default(now())
  lastReviewedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  meta Meta @relation(fields: [metaId], references: [id], onDelete: Cascade)

  @@unique([userId, metaId])
  @@index([userId, dueAt])
}

model ReviewLog {
  id                 String   @id @default(cuid())
  userId             String
  metaId             String
  guessedCountryCode String
  correct            Boolean
  responseMs         Int
  grade              Int
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  meta Meta @relation(fields: [metaId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, correct])
}

model DailyActivity {
  id      String   @id @default(cuid())
  userId  String
  day     DateTime @db.Date
  reviews Int      @default(0)
  correct Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId, day])
}

// ---------------------------------------------------------------------------
// Scored runs and progression
// ---------------------------------------------------------------------------

/// PRACTICE is the untimed spaced-repetition session. The rest are scored
/// runs that end on their own terms and land on the leaderboard.
enum GameMode {
  PRACTICE
  RUSH
  SURVIVAL
  DAILY
  DRILL
}

/// One scored run. The server deals the cards and keeps the score, so a
/// leaderboard row can only be earned by actually playing.
model GameRun {
  id     String   @id @default(cuid())
  userId String
  mode   GameMode

  /// The hand, in the order it is dealt. Kept here so the client is never
  /// told what is coming and cannot look an answer up in advance.
  metaIds    String[]
  /// How far through the hand the player is.
  cursor     Int      @default(0)
  answered   Int      @default(0)
  correct    Int      @default(0)
  score      Int      @default(0)
  /// Correct answers behind the card now on screen. Held on the run rather
  /// than counted back from the answer log, which cannot tell this run's
  /// answers apart from a practice session in another tab.
  streak     Int      @default(0)
  bestStreak Int      @default(0)

  /// The collection the hand was drawn from, when the run was started from
  /// one. Held so a resumed run is the same collection the player left.
  deckId     String?
  /// UTC day, only for the daily challenge. Null elsewhere, and Postgres
  /// leaves nulls out of a unique index, so ordinary runs stay unlimited.
  day        String?
  startedAt  DateTime  @default(now())
  /// When the card now on screen was handed out. The client reports how long
  /// it took to answer, and that report is capped by this, so a doctored
  /// clock cannot buy a speed bonus.
  servedAt   DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int       @default(0)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck Deck? @relation(fields: [deckId], references: [id], onDelete: SetNull)

  @@unique([userId, day])
  @@index([userId, finishedAt])
  @@index([mode, score])
  @@index([finishedAt])
}

/// A badge a player has earned. The catalogue itself lives in code: the name
/// and the description belong in the translation files.
model UserAchievement {
  id         String   @id @default(cuid())
  userId     String
  code       String
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Blog, footer pages and search-engine settings
// ---------------------------------------------------------------------------

enum ContentStatus {
  DRAFT
  PUBLISHED
}

/// A blog post in one language. Posts are not translations of each other: an
/// author writes for one audience at a time, and forcing a pair would leave
/// half-written stubs in the other language.
model Post {
  id      String @id @default(cuid())
  /// "en" or "tr". Readers only ever see posts in the locale they browse in.
  locale  String
  slug    String
  title   String
  excerpt String @default("")
  /// Sanitised HTML from the editor.
  content String

  coverImageUrl String?
  coverImageKey String?

  metaTitle       String?
  metaDescription String?
  keywords        String  @default("")
  canonicalUrl    String?
  robotsMeta      String  @default("index,follow")

  ogImageUrl String?

  /// Counted when the post is saved: the list response carries no body, so it
  /// cannot be worked out at read time.
  wordCount   Int @default(0)
  readingTime Int @default(1)

  status      ContentStatus @default(DRAFT)
  /// First time it went live. Written once, so editing a post later does not
  /// move its publication date to today.
  publishedAt DateTime?
  viewCount   Int           @default(0)

  authorId String?
  author   User?   @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, slug])
  @@index([locale, status, publishedAt])
  @@index([authorId])
}

/// A standing page reached from the footer: about, privacy, cookies, terms.
/// Same search-engine fields as a post, but it lives at its own address rather
/// than in a feed.
model Page {
  id      String @id @default(cuid())
  locale  String
  slug    String
  title   String
  excerpt String @default("")
  content String

  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  robotsMeta      String  @default("index,follow")

  status           ContentStatus @default(PUBLISHED)
  /// Published is not the same as worth indexing, so this is its own switch.
  includeInSitemap Boolean       @default(true)
  /// Position in the footer. Pages with no place there sort last.
  footerOrder      Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([locale, slug])
  @@index([locale, status])
}

/// Site-wide search-engine settings. One row, so "which settings apply" has a
/// single answer; the service creates it with defaults on first read.
model SiteSeo {
  id String @id @default("site")

  siteName        String @default("AcademyGeo")
  siteUrl         String @default("http://localhost:3000")
  siteDescription String @default("")

  defaultMetaTitle       String  @default("")
  defaultMetaDescription String  @default("")
  defaultKeywords        String  @default("")
  defaultOgImageUrl      String?

  /// Hand-written robots.txt. Replaces the generated default when filled in.
  robotsTxt                      String?
  defaultRobotsMeta              String  @default("index,follow")
  /// Keep every environment that is not production out of the index.
  blockIndexingOutsideProduction Boolean @default(true)
  sitemapEnabled                 Boolean @default(true)

  googleSiteVerification String?
  googleAnalyticsId      String?
  googleTagManagerId     String?
  bingSiteVerification   String?

  twitterSite String?

  /// Drawn as JSON-LD so search engines can show the project as an entity.
  organisationName String  @default("AcademyGeo")
  organisationLogo String?
  contactEmail     String?

  updatedAt DateTime @updatedAt
}
