# ---------------------------------------------------------------------------
# AcademyGeo web
# Copy to .env.local and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# Browser-visible URL of the NestJS API.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Base URL Better Auth's browser client calls. Usually the API URL.
NEXT_PUBLIC_AUTH_URL=http://localhost:3001

# Public URL of this app, used for OAuth redirects back from the API.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The R2 bucket address that serves uploaded card pictures. Paste what
# Cloudflare shows, e.g. https://pub-abc123.r2.dev, or just the hostname.
# next/image refuses to load pictures from a host it has not been told about,
# so leaving this empty makes every uploaded picture a broken image.
NEXT_PUBLIC_MEDIA_HOST=

# Optional: server-side URL used during SSR when the API is reachable on an
# internal hostname (Docker network). Falls back to NEXT_PUBLIC_API_URL.
# INTERNAL_API_URL=http://backend:3001

# Locale detection. When the platform does not supply a geo header
# (x-vercel-ip-country / cf-ipcountry), this country code is assumed.
DEFAULT_COUNTRY=
